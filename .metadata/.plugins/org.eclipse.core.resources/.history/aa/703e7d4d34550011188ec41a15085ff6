package com.kyc.kyc_verification_system.controller;

import java.io.InputStream;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import org.springframework.web.reactive.function.client.WebClient;

import org.springframework.web.servlet.mvc.method.annotation.StreamingResponseBody;

@RestController
@RequestMapping("/kyc")
public class FaceDetectionController {

    @Autowired
    private WebClient webClient;

    @GetMapping(
            value = "/video-feed/{sessionId}",
            produces = "multipart/x-mixed-replace; boundary=frame"
    )
    public StreamingResponseBody streamVideo(
            @PathVariable String sessionId
    ) {

        return outputStream -> {

            try {

                InputStream inputStream = webClient.get()

                        .uri(uriBuilder ->
                                uriBuilder
                                        .path("/video_feed")
                                        .queryParam(
                                                "sessionId",
                                                sessionId
                                        )
                                        .build()
                        )

                        .accept(
                                MediaType.parseMediaType(
                                        "multipart/x-mixed-replace; boundary=frame"
                                )
                        )

                        .retrieve()

                        .bodyToMono(InputStream.class)

                        .block();

                byte[] buffer = new byte[4096];

                int bytesRead;

                while (inputStream != null &&
                        (bytesRead = inputStream.read(buffer)) != -1) {

                    outputStream.write(
                            buffer,
                            0,
                            bytesRead
                    );

                    outputStream.flush();
                }

                if (inputStream != null) {
                    inputStream.close();
                }

            } catch (Exception exception) {

                exception.printStackTrace();
            }
        };
    }
}