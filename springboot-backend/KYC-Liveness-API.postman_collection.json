{
  "info": {
    "name": "KYC Face Liveness API",
    "_postman_id": "kyc-liveness-collection-v1",
    "description": "Complete API collection for KYC Face Liveness Verification — Spring Boot backend on http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string",
      "description": "Auto-populated from create-session response"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/liveness/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "liveness", "health"]
        },
        "description": "Confirms the Spring Boot backend is running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Backend is running', function () {",
              "    pm.expect(pm.response.text()).to.include('running');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "KYC Liveness Backend is running."
        }
      ]
    },
    {
      "name": "2. Get Temporary AWS Credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/liveness/credentials",
          "host": ["{{baseUrl}}"],
          "path": ["api", "liveness", "credentials"]
        },
        "description": "Returns short-lived AWS credentials via STS GetSessionToken.\nUsed by React FaceLivenessDetector as credentialProvider.\nNo Cognito / Identity Pool required."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has accessKeyId', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('accessKeyId');",
              "    pm.expect(json.accessKeyId).to.not.be.empty;",
              "});",
              "pm.test('Response has region', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('region');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "200 OK — STS temporary credentials",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"accessKeyId\": \"ASIAIOSFODNN7EXAMPLE\",\n  \"secretAccessKey\": \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\",\n  \"sessionToken\": \"AQoDYXdzEJr...\",\n  \"region\": \"us-east-1\"\n}"
        }
      ]
    },
    {
      "name": "3. Create Liveness Session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/liveness/create-session",
          "host": ["{{baseUrl}}"],
          "path": ["api", "liveness", "create-session"]
        },
        "description": "Creates a new AWS Rekognition Face Liveness session.\nReturns a sessionId to be passed to the React FaceLivenessDetector component."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has sessionId', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('sessionId');",
              "    pm.expect(json.sessionId).to.not.be.empty;",
              "    // Auto-save sessionId for next requests",
              "    pm.collectionVariables.set('sessionId', json.sessionId);",
              "    console.log('Session ID saved:', json.sessionId);",
              "});",
              "pm.test('Response has message', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('message');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"sessionId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"message\": \"Session created successfully\"\n}"
        }
      ]
    },
    {
      "name": "4. Get Liveness Result",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/liveness/result/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "liveness", "result", "{{sessionId}}"]
        },
        "description": "Fetches the liveness verification result from AWS Rekognition.\nUse the sessionId returned from Create Liveness Session.\nNote: Call this ONLY after the user completes the FaceLivenessDetector flow in the React app.\nCalling it before completion returns status CREATED with 0 confidence."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has required fields', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('sessionId');",
              "    pm.expect(json).to.have.property('status');",
              "    pm.expect(json).to.have.property('confidence');",
              "    pm.expect(json).to.have.property('isLive');",
              "    pm.expect(json).to.have.property('message');",
              "});",
              "pm.test('Confidence is a number', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.confidence).to.be.a('number');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "200 OK — Verified",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"sessionId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"status\": \"SUCCEEDED\",\n  \"confidence\": 97.5,\n  \"isLive\": true,\n  \"message\": \"Identity verified successfully.\"\n}"
        },
        {
          "name": "200 OK — Not Live",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"sessionId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"status\": \"SUCCEEDED\",\n  \"confidence\": 45.2,\n  \"isLive\": false,\n  \"message\": \"Liveness not confirmed.\"\n}"
        }
      ]
    },
    {
      "name": "5. Upload Verification Video",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "video",
              "type": "file",
              "src": "",
              "description": "Select a .webm video file from your machine"
            },
            {
              "key": "sessionId",
              "value": "{{sessionId}}",
              "type": "text",
              "description": "Session ID from create-session"
            },
            {
              "key": "timestamp",
              "value": "2024-01-01T10:00:00.000Z",
              "type": "text",
              "description": "ISO 8601 timestamp"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/liveness/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "liveness", "upload"]
        },
        "description": "Uploads the recorded WebM verification video.\nSaves to the /uploads directory on the server.\nUse form-data with: video (file), sessionId (text), timestamp (text)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Upload successful', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json).to.have.property('filename');",
              "    pm.expect(json).to.have.property('size');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"success\": true,\n  \"filename\": \"kyc-a1b2c3d4-uuid.webm\",\n  \"sessionId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"timestamp\": \"2024-01-01T10:00:00.000Z\",\n  \"size\": 204800,\n  \"message\": \"Video uploaded successfully.\"\n}"
        }
      ]
    }
  ]
}
